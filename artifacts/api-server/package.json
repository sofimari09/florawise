{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "export NODE_ENV=development && pnpm run build && pnpm run start",
    "build": "node ./build.mjs",
    "start": "node --enable-source-maps ./dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate:names": "esbuild src/lib/run-plant-name-migration.ts --bundle --platform=node --format=esm --external:pg --loader:.sql=text --outfile=dist/migrate-names.mjs && node dist/migrate-names.mjs",
    "test:identity": "esbuild src/lib/plant-identity.test.ts --bundle --platform=node --format=esm --external:pg --loader:.sql=text --outfile=dist/identity.test.mjs && node --test dist/identity.test.mjs",
    "test:identity-startup": "node --test src/lib/plant-identity-startup.test.mjs",
    "test:identity-flow": "node --test src/lib/plant-identity-flow.test.mjs",
    "test:photos": "esbuild src/lib/plant-photos.test.ts --bundle --platform=node --format=esm --outfile=dist/photos.test.mjs && node --test dist/photos.test.mjs",
    "test:rules": "esbuild src/lib/recommendation-engine.test.ts --bundle --platform=node --format=esm --outfile=dist/rules.test.mjs && node --test dist/rules.test.mjs"
    ,"test:categories": "esbuild src/lib/category-care.test.ts --bundle --platform=node --format=esm --external:pg --outfile=dist/category-care.test.mjs && node --test dist/category-care.test.mjs"
    ,"test:category-api": "node --test src/lib/category-api.test.mjs"
    ,"test:custom-api": "node --test src/lib/custom-plant-api.test.mjs"
  },
  "dependencies": {
    "@clerk/express": "^2.1.67",
    "@clerk/shared": "^4.31.1",
    "@google-cloud/storage": "^8.2.0",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "@workspace/plant-care": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "catalog:",
    "express": "^5.2.1",
    "google-auth-library": "^11.1.0",
    "http-proxy-middleware": "^4.2.0",
    "pg": "^8.23.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.2",
    "esbuild-plugin-pino": "^2.3.3",
    "pino-pretty": "^13.1.3",
    "thread-stream": "3.1.0"
  }
}
